{
  "name": "bilivideo",
  "author": "lzqlzq21",
  "title": "bilivideo",
  "description": "下载b站视频",
  "icon": "icon.png",
  "version": "0.0.3",
  "homepage": "https://github.com/lzqlzq21/gopeed-extension-bilivideo",
  "repository": { "url": "https://github.com/lzqlzq21/gopeed-extension-bilivideo" },
  "scripts": [
    {
      "event": "onResolve",
      "match": { "urls": [ "*://*.bilibili.com/video/*" ] },
      "entry": "dist/index.js"
    },
    {
      "event": "onStart",
      "match": { "labels": [ "lzqlzq21@bilibili" ] },
      "entry": "dist/index.js"
    },
    {
      "event": "onError",
      "match": { "labels": [ "lzqlzq21@bilibili" ] },
      "entry": "dist/index.js"
    }
  ],
  "settings": [
    {
      "name": "cookie",
      "type": "string",
      "valve": "",
      "title": "Cookie"
    },
    {
      "name": "stm",
      "type": "string",
      "value": "mp4",
      "options": [
        { "label": "MP4", "value": "mp4" },
        { "label": "DASH", "value": "dash" }
      ],
      "title": "流媒体",
      "description": "首选流媒体，DASH 会使音视频分离"
    },
    {
